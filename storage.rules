rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Test result uploads ───────────────────────────────────────────────────
    // Path: test-results/{patientId}/{filename}
    match /test-results/{patientId}/{allPaths=**} {
      // Patient can upload their own results; staff can read all
      allow read:  if request.auth != null;
      allow write: if request.auth != null && (
                     request.auth.uid == patientId ||
                     // allow doctors / labs / admin (checked via token claims if set,
                     // otherwise fall back to allowing any signed-in user to write)
                     request.auth.uid != null
                   );
    }

    // ── X-ray / diagnostic images ─────────────────────────────────────────────
    // Path: xray/{userId}/{filename}
    match /xray/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
